{
  "Prompt": {
    "prefix": ".title",
    "body": [
      ".title ${1:Name}",
      "",
      "$0"
    ],
    "description": "A prompt: becomes a Go struct with a String method"
  },
  "Tool": {
    "prefix": ".tool",
    "body": [
      ".tool ${1:name}",
      ".param ${2:query} ${3:What to search for.}",
      "",
      "${4:Describe what the tool does, for the model.}"
    ],
    "description": "An LLM tool: JSON Schema, typed Args and a strict decoder"
  },
  "Route": {
    "prefix": ".route",
    "body": [
      ".route ${1|GET,POST,PUT,PATCH,DELETE|} /${2:things}/{${3:id}} ${4:GetThing}",
      ".auth ${5:owner_id}",
      "$0"
    ],
    "description": "An HTTP route that serves a sqlc query"
  },
  "Conditional": {
    "prefix": "<?",
    "body": [
      "<?${1:path}>",
      "$0",
      "</$1>"
    ],
    "description": "Render when the value is non-zero"
  },
  "Conditional with else": {
    "prefix": "<?else",
    "body": [
      "<?${1:path}>",
      "$2",
      "<else>",
      "$0",
      "</$1>"
    ],
    "description": "Conditional with an else branch"
  },
  "Loop": {
    "prefix": "<*",
    "body": [
      "<*${1:items} []${2:Item} as ${3:item}>",
      "$0",
      "</$1>"
    ],
    "description": "Loop over a Go slice"
  },
  "Structured output": {
    "prefix": ".output",
    "body": [
      ".output ${1:name}",
      ".field ${2:answer} ${3:What the model answers.}",
      "",
      "${4:Describe the output.}"
    ],
    "description": "A structured output: Go struct, strict JSON Schema, decoder and a field list for the prompt"
  },
  "Agent": {
    "prefix": ".agent",
    "body": [
      ".agent ${1:name}",
      ".tools ${2:tool_a, tool_b}",
      ".maxturns ${3:8}",
      "",
      "${4:What the agent does.}"
    ],
    "description": "A tool-calling agent over this file's prompt and tools"
  },
  "SQL route": {
    "prefix": ".sql",
    "body": [
      ".sql ${1|:one,:many,:exec,:execrows|}",
      "${2:SELECT * FROM things WHERE id = @id}"
    ],
    "description": "Write the route's sqlc query inline"
  }
}
