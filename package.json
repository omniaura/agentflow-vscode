{
  "name": "agentflow-vscode",
  "displayName": "AgentFlow",
  "description": "VS Code support for AgentFlow: prompts, LLM tools and sqlc-backed routes in .af files, with diagnostics, formatting, go to definition, rename, hovers and completions via the AgentFlow LSP.",
  "version": "0.4.0",
  "publisher": "omniaura",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/omniaura/agentflow-vscode",
  "bugs": {
    "url": "https://github.com/omniaura/agentflow-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omniaura/agentflow-vscode.git"
  },
  "author": {
    "name": "OmniAura",
    "url": "https://github.com/omniaura"
  },
  "keywords": [
    "agentflow",
    "prompting",
    "templates",
    "lsp",
    "ai"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:agentflow",
    "onCommand:agentflow.createDemoProject",
    "onCommand:agentflow.restartLanguageServer",
    "onCommand:agentflow.generate",
    "onCommand:agentflow.check",
    "onCommand:agentflow.installSkills",
    "onCommand:agentflow.ejectRuntime"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "bun run typecheck && esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=./out/extension.js --sourcemap --minify",
    "watch": "tsc -watch -p ./",
    "test": "bun test src",
    "package": "vsce package",
    "vscode:prepublish": "bun run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "agentflow",
        "aliases": [
          "AgentFlow",
          "agentflow"
        ],
        "extensions": [
          ".af"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agentflow",
        "scopeName": "source.af",
        "path": "./syntaxes/agentflow.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "agentflow.createDemoProject",
        "title": "AgentFlow: Create Demo Project"
      },
      {
        "command": "agentflow.restartLanguageServer",
        "title": "AgentFlow: Restart Language Server"
      },
      {
        "command": "agentflow.generate",
        "title": "AgentFlow: Generate Go Code"
      },
      {
        "command": "agentflow.check",
        "title": "AgentFlow: Check Generated Code"
      },
      {
        "command": "agentflow.installSkills",
        "title": "AgentFlow: Install Agent Skills"
      },
      {
        "command": "agentflow.ejectRuntime",
        "title": "AgentFlow: Eject Runtime"
      }
    ],
    "configuration": {
      "title": "AgentFlow",
      "properties": {
        "agentflow.languageServer.command": {
          "type": "string",
          "default": "af",
          "description": "Command used to launch the AgentFlow language server. Leave this at the default to let the extension auto-detect `go tool af` from the workspace go.mod."
        },
        "agentflow.languageServer.args": {
          "type": "array",
          "default": [
            "lsp",
            "--mode",
            "stdio"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the AgentFlow language server command. Leave this at the default to let the extension auto-detect `go tool af` from the workspace go.mod."
        },
        "agentflow.languageServer.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Trace level forwarded to the language client output channel."
        }
      }
    },
    "snippets": [
      {
        "language": "agentflow",
        "path": "./snippets/agentflow.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
