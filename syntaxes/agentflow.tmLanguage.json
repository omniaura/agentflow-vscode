{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "AgentFlow",
	"patterns": [
		{
			"include": "#routeSection"
		},
		{
			"include": "#sectionHeader"
		},
		{
			"include": "#paramDirective"
		},
		{
			"include": "#sectionDirective"
		},
		{
			"include": "#titleKeyword"
		},
		{
			"include": "#conditionalDirective"
		},
		{
			"include": "#endDirective"
		},
		{
			"include": "#elseDirective"
		},
		{
			"include": "#variableDirective"
		},
		{
			"include": "#loopDirective"
		}
	],
	"repository": {
		"titleKeyword": {
			"match": "^(\\.title)(\\s+)([^\\r\\n]+)$",
			"captures": {
				"1": {
					"name": "keyword.control.title.agentflow"
				},
				"3": {
					"name": "entity.name.function.agentflow"
				}
			}
		},
		"conditionalDirective": {
			"begin": "(<)(\\?)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.agentflow"
				},
				"2": {
					"name": "keyword.control.conditional.agentflow"
				}
			},
			"end": "(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.end.agentflow"
				}
			},
			"name": "meta.directive.conditional.agentflow",
			"patterns": [
				{
					"include": "#comparisonOperator"
				},
				{
					"include": "#typeAnnotation"
				},
				{
					"include": "#stringLiteral"
				},
				{
					"include": "#numberLiteral"
				},
				{
					"include": "#booleanLiteral"
				},
				{
					"include": "#directivePath"
				}
			]
		},
		"endDirective": {
			"match": "(<)(/)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(>)",
			"captures": {
				"1": {
					"name": "punctuation.definition.tag.begin.agentflow"
				},
				"2": {
					"name": "keyword.control.conditional.agentflow"
				},
				"3": {
					"name": "entity.name.tag.agentflow"
				},
				"4": {
					"name": "punctuation.definition.tag.end.agentflow"
				}
			}
		},
		"elseDirective": {
			"match": "(<)(else)(>)",
			"captures": {
				"1": {
					"name": "punctuation.definition.tag.begin.agentflow"
				},
				"2": {
					"name": "keyword.control.conditional.agentflow"
				},
				"3": {
					"name": "punctuation.definition.tag.end.agentflow"
				}
			}
		},
		"variableDirective": {
			"begin": "(<)(!)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.agentflow"
				},
				"2": {
					"name": "keyword.other.substitution.agentflow"
				}
			},
			"end": "(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.end.agentflow"
				}
			},
			"name": "meta.directive.variable.agentflow",
			"patterns": [
				{
					"include": "#typeAnnotation"
				},
				{
					"include": "#directivePath"
				}
			]
		},
		"comparisonOperator": {
			"match": "\\b(?:eq|ne|gt|lt|gte|lte)\\b",
			"name": "keyword.operator.comparison.agentflow"
		},
		"typeAnnotation": {
			"match": "\\b(?:string|int|bool|float32|float64)\\b",
			"name": "storage.type.agentflow"
		},
		"directivePath": {
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\b",
			"name": "variable.other.agentflow"
		},
		"stringLiteral": {
			"match": "\"(?:\\\\.|[^\"\\\\])*\"",
			"name": "string.quoted.double.agentflow"
		},
		"numberLiteral": {
			"match": "\\b\\d+(?:\\.\\d+)?\\b",
			"name": "constant.numeric.agentflow"
		},
		"booleanLiteral": {
			"match": "\\b(?:true|false)\\b",
			"name": "constant.language.boolean.agentflow"
		},
		"routeSection": {
			"comment": ".route METHOD /path Query starts a section that runs to the next section; only it may hold a .sql query",
			"begin": "^(\\.route)(\\s+)(GET|HEAD|POST|PUT|PATCH|DELETE)(\\s+)(\\S+)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)\\s*$",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.route.agentflow"
				},
				"3": {
					"name": "keyword.other.method.agentflow"
				},
				"5": {
					"name": "string.unquoted.path.agentflow"
				},
				"7": {
					"name": "entity.name.function.agentflow"
				}
			},
			"end": "^(?=\\.(?:title|tool|output|route|agent)\\b)",
			"patterns": [
				{
					"include": "#sqlBlock"
				},
				{
					"include": "#sectionDirective"
				}
			]
		},
		"sectionHeader": {
			"comment": ".tool name, .output name and .agent name start declaration sections; .route is routeSection",
			"patterns": [
				{
					"match": "^(\\.(?:tool|output|agent))(\\s+)([A-Za-z0-9_-]+)\\s*$",
					"captures": {
						"1": {
							"name": "keyword.control.tool.agentflow"
						},
						"3": {
							"name": "entity.name.function.agentflow"
						}
					}
				}
			]
		},
		"paramDirective": {
			"match": "^(\\.(?:param|field))(\\s+)([A-Za-z_][A-Za-z0-9_.\\[\\]]*\\??)(?:(\\s+)((?:\\[\\])?(?:string|integer|int|float64|float|number|boolean|bool|object|any|enum\\([^)]*\\))\\??)(?=\\s|$))?(.*)$",
			"captures": {
				"1": {
					"name": "keyword.control.param.agentflow"
				},
				"3": {
					"name": "variable.parameter.agentflow"
				},
				"5": {
					"name": "storage.type.agentflow"
				},
				"6": {
					"name": "string.unquoted.description.agentflow"
				}
			}
		},
		"sectionDirective": {
			"match": "^(\\.(?:maxbytes|auth|public|status|system|tools|maxturns|returns|serve))\\b(.*)$",
			"captures": {
				"1": {
					"name": "keyword.control.directive.agentflow"
				},
				"2": {
					"name": "variable.parameter.agentflow"
				}
			}
		},
		"sqlBlock": {
			"comment": "A .sql line in a .route section: the rest of the section is a sqlc query",
			"begin": "^(\\.sql)(\\s+)(:one|:many|:exec|:execrows)\\s*$",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.agentflow"
				},
				"3": {
					"name": "storage.modifier.sqlc.agentflow"
				}
			},
			"end": "^(?=\\.(?:title|tool|output|route|agent)\\b)",
			"contentName": "meta.embedded.block.sql",
			"patterns": [
				{
					"include": "source.sql"
				}
			]
		},
		"loopDirective": {
			"match": "(<)(\\*)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\s+)(\\S+)(\\s+)(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\s*(>)",
			"captures": {
				"1": {
					"name": "punctuation.definition.tag.begin.agentflow"
				},
				"2": {
					"name": "keyword.control.loop.agentflow"
				},
				"3": {
					"name": "variable.other.agentflow"
				},
				"5": {
					"name": "storage.type.agentflow"
				},
				"7": {
					"name": "keyword.control.loop.agentflow"
				},
				"9": {
					"name": "variable.other.alias.agentflow"
				},
				"10": {
					"name": "punctuation.definition.tag.end.agentflow"
				}
			}
		}
	},
	"scopeName": "source.af"
}
